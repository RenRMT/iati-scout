# IATI API subscription key (from https://developer.iatistandard.org/).
# The same key covers both products this tool uses: Datastore and Validator.
IATI_API_KEY=

# Default IATI organisation identifier to fetch, e.g. NL-KVK-27378529
# Can be overridden with --org-id on the command line.
IATI_ORG_ID=
